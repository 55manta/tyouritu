{
  "expo": {
    "name": "調律ノート",
    "slug": "choritsu-note",
    "scheme": "choritsunote",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F2EC",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F2EC",
          "dark": {
            "backgroundColor": "#12110D"
          }
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/auth",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "作業の記録に写真を添えるため、写真へのアクセスを求めています。お客様の同意をいただいた場合にだけ保存します。",
          "cameraPermission": "ピアノの作業前後を撮って記録に残すため、カメラの使用を求めています。お客様の同意をいただいた場合にだけ保存します。"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.izumikawa.choritsunote",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "jp.izumikawa.choritsunote",
      "adaptiveIcon": {
        "backgroundColor": "#F4F2EC",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "af261cf3-153d-4ed4-8d39-e237d79b2313"
      }
    },
    "owner": "manta55"
  }
}
